# NTA Developer Portal API Primary/Secondary Key
# Register at: https://developer.nationaltransport.ie/
NTA_API_KEY=your_nta_api_key_here

# Polling interval in seconds (default 65 to strictly abide by Fair Usage Policy <= 1 req/60s)
POLL_INTERVAL_SECONDS=65

# Target transport operators to track (comma-separated agency names or IDs)
# Supported: Dublin Bus, Go-Ahead Ireland, Iarnród Éireann, Luas
TARGET_AGENCIES=Dublin Bus,Go-Ahead Ireland,Iarnród Éireann,Luas

# SQLite Database storage location
DB_PATH=data/nta_stats.db

# GTFS Static Download URL (optional override)
# GTFS_STATIC_URL=https://www.transportforireland.ie/transitData/Data/GTFS_All.zip

# Grace period in minutes after scheduled arrival before marking an unseen trip as GHOST
GHOST_GRACE_MINUTES=20
